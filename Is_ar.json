    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO spares_history (id, name, description, type, status, price, quantity, updated_at, last_synced_at, is_deleted) \nSELECT src.\"spareCode\", src.\"spareName\", src.\"spareDescription\", src.\"spareType\", src.\"spareStatus\", src.\"price\", src.\"quantity\", src.\"updatedAt\", NOW(), FALSE \nFROM jsonb_to_recordset($1::jsonb) AS src(\"spareCode\" text, \"spareName\" text, \"spareDescription\" text, \"spareType\" text, \"spareStatus\" text, \"price\" numeric, \"quantity\" integer, \"updatedAt\" text) \nON CONFLICT (id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($('Синхронизация CMS и БД').first().json.insert) }}"
        }
