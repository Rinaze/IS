    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, description, type, status, price, quantity, updated_at, is_deleted \nFROM spares_history;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        96
      ],
      "id": "bcab9f6c-2c6b-4b9e-b25e-5cc1d8f3b2e8",
      "name": "Чтение БД",
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "WjEIsEWypATWKPvc",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const remoteData = $('CMS').all().map(i => i.json).filter(i => i.spareCode);\nconst localData = $('Чтение БД').all().map(i => i.json).filter(i => i.id);\n\nconst remoteLookup = new Map(remoteData.map(item => [String(item.spareCode), item]));\nconst localLookup = new Map(localData.map(item => [String(item.id), item]));\n\nconst normalize = val => (val === null || val === undefined ? '' : String(val));\n\nfunction isModified(remote, local) {\n  return (\n    normalize(remote.spareName) !== normalize(local.name) ||\n    normalize(remote.spareDescription) !== normalize(local.description) ||\n    normalize(remote.spareType) !== normalize(local.type) ||\n    normalize(remote.spareStatus) !== normalize(local.status) ||\n    Number(remote.price) !== Number(local.price) ||\n    Number(remote.quantity) !== Number(local.quantity) ||\n    normalize(remote.updatedAt) !== normalize(local.updated_at)\n  );\n}\n\nlet insert = [];\nlet update = [];\nlet deleteList = [];\n\nfor (let [code, remoteObj] of remoteLookup) {\n  let localObj = localLookup.get(code);\n  if (!localObj) {\n    insert.push(remoteObj);\n  } else if (localObj.is_deleted || isModified(remoteObj, localObj)) {\n    update.push(remoteObj);\n  }\n}\n\nfor (let [code, localObj] of localLookup) {\n  if (!remoteLookup.has(code) && !localObj.is_deleted) {\n    deleteList.push(code);\n  }\n}\n\nreturn [{\n  json: {\n    remote_total: remoteLookup.size,\n    local_total: localLookup.size,\n    insert: insert,\n    update: update,\n    delete: deleteList\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        96
      ],
      "id": "e0e188a3-82fe-458c-ae13-77a22b3fb1c4",
      "name": "Синхронизация CMS и БД"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE spares_history AS target SET \n  name = payload.\"spareName\", \n  description = payload.\"spareDescription\", \n  type = payload.\"spareType\", \n  status = payload.\"spareStatus\", \n  price = payload.\"price\", \n  quantity = payload.\"quantity\", \n  updated_at = payload.\"updatedAt\", \n  last_synced_at = NOW(), \n  is_deleted = FALSE, \n  deleted_at = NULL \nFROM jsonb_to_recordset($1::jsonb) AS payload(\"spareCode\" text, \"spareName\" text, \"spareDescription\" text, \"spareType\" text, \"spareStatus\" text, \"price\" numeric, \"quantity\" integer, \"updatedAt\" text) \nWHERE target.id = payload.\"spareCode\";",
        "options": {
          "queryReplacement": "={{ JSON.stringify($('Синхронизация CMS и БД').first().json.update) }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
