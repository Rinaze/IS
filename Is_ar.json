    },
    {
      "parameters": {
        "jsCode": "const COLUMNS = ['spareCode', 'spareName', 'spareDescription', 'spareType', 'spareStatus', 'price', 'quantity', 'updatedAt'];\n\nconst formatValue = val => {\n  const strVal = val === null || val === undefined ? '' : String(val);\n  return /[;\"\\r\\n]/.test(strVal) ? '\"' + strVal.replace(/\"/g, '\"\"') + '\"' : strVal;\n};\n\nconst dataset = $input.all().map(el => el.json).filter(row => row.spareCode);\nconst csvOutput = dataset.map(row => COLUMNS.map(col => formatValue(row[col])).join(';')).join('\\n');\n\nreturn [{ json: { record_count: dataset.length, csv: csvOutput } }];"
      },
